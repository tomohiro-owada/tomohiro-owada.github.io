<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title or "Blog" }} | Tomo's Diary</title>
    
    {%- set pageDescription = description or excerpt or site.description -%}
    {%- set pageTitle = (title or "Blog") + " | " + site.title -%}
    {%- set heroImage = image or ogImage or site.defaultImage -%}
    {%- set heroImageAbs = heroImage | absoluteUrl(site.url) -%}
    {%- set heroAlt = imageAlt or title or site.defaultImageAlt -%}
    {%- set pageUrl = page.url | absoluteUrl(site.url) -%}
    <!-- SEO Meta Tags -->
    <meta name="description" content="{{ pageDescription }}">
    <meta name="author" content="{{ site.author }}">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="{{ 'article' if (page.url and '/posts/' in page.url) else 'website' }}">
    <meta property="og:site_name" content="{{ site.title }}">
    <meta property="og:url" content="{{ pageUrl }}">
    <meta property="og:title" content="{{ pageTitle }}">
    <meta property="og:description" content="{{ pageDescription }}">
    <meta property="og:image" content="{{ heroImageAbs }}">
    <meta property="og:image:alt" content="{{ heroAlt }}">
    <meta property="og:locale" content="ja_JP">

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="{{ pageUrl }}">
    <meta name="twitter:title" content="{{ pageTitle }}">
    <meta name="twitter:description" content="{{ pageDescription }}">
    <meta name="twitter:image" content="{{ heroImageAbs }}">
    <meta name="twitter:image:alt" content="{{ heroAlt }}">

    <!-- Canonical URL -->
    <link rel="canonical" href="{{ pageUrl }}">

    <!-- RSS Feed -->
    <link rel="alternate" type="application/rss+xml" title="Tomo's Diary RSS Feed" href="/rss.xml">
    
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <h1><a href="/">Tomo's Diary</a></h1>
    </header>
    <main>
        {{ content | safe }}
    </main>
    <footer>
        <p>&copy; {{ page.date.getFullYear() if page.date else "2025" }} All rights reserved.</p>
    </footer>
</body>
</html>
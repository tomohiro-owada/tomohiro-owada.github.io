{#-
  SNS share links (plain intent URLs; no SDKs, widgets or trackers).
  Set before including: shareCompact = true for the icon-only row under the title.
-#}
{%- set shareUrl = page.url | absoluteUrl(site.url) -%}
{%- set u = shareUrl | urlencode -%}
{%- set t = title | urlencode -%}
<div class="share{% if shareCompact %} share--compact{% endif %}">
  {%- if not shareCompact %}
  <p class="share__heading">この記事をシェア</p>
  {%- endif %}
  <ul class="share__list">
    <li><a class="share-btn share-btn--x" data-share-method="x" href="https://x.com/intent/post?text={{ t }}&amp;url={{ u }}" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.58-6.64 7.58H.47l8.6-9.83L0 1.15h7.59l5.24 6.93 6.07-6.93Zm-1.29 19.5h2.04L6.49 3.24H4.3l13.31 17.41Z"/></svg>
      <span class="share-btn__label">ポスト</span><span class="sr-only">（Xで共有・新しいタブ）</span></a></li>
    <li><a class="share-btn share-btn--facebook" data-share-method="facebook" href="https://www.facebook.com/sharer/sharer.php?u={{ u }}" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M13.5 21.9v-7.2h2.4l.4-2.9h-2.8V10c0-.8.3-1.4 1.4-1.4h1.5V6c-.3 0-1.2-.1-2.2-.1-2.2 0-3.6 1.3-3.6 3.7v2.2H8.2v2.9h2.4v7.2A10 10 0 1 1 13.5 21.9Z"/></svg>
      <span class="share-btn__label">シェア</span><span class="sr-only">（Facebookで共有・新しいタブ）</span></a></li>
    <li><a class="share-btn share-btn--line" data-share-method="line" href="https://social-plugins.line.me/lineit/share?url={{ u }}" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2.5C6.2 2.5 1.5 6.3 1.5 11c0 4.2 3.7 7.7 8.8 8.4.3.1.8.2.9.5.1.3.1.7 0 1l-.2.9c0 .3-.2 1 .9.6 1.1-.5 6-3.5 8.2-6.1 1.5-1.6 2.3-3.3 2.3-5.3 0-4.7-4.7-8.5-10.4-8.5Z"/><text x="12" y="13.6" text-anchor="middle" font-size="5.6" font-weight="700" font-family="Arial, sans-serif" fill="#fff">LINE</text></svg>
      <span class="share-btn__label">LINE</span><span class="sr-only">で送る（新しいタブ）</span></a></li>
    <li><a class="share-btn share-btn--hatena" data-share-method="hatena_bookmark" href="https://b.hatena.ne.jp/add?mode=confirm&amp;url={{ u }}&amp;title={{ t }}" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><text x="12" y="17.5" text-anchor="middle" font-size="15" font-weight="800" font-family="Arial, Helvetica, sans-serif" fill="currentColor">B!</text></svg>
      <span class="share-btn__label">はてブ</span><span class="sr-only">（はてなブックマークに追加・新しいタブ）</span></a></li>
    <li><a class="share-btn share-btn--threads" data-share-method="threads" href="https://www.threads.net/intent/post?text={{ (title + ' ' + shareUrl) | urlencode }}" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><text x="12" y="18" text-anchor="middle" font-size="18" font-weight="700" font-family="Arial, Helvetica, sans-serif" fill="currentColor">@</text></svg>
      <span class="share-btn__label">Threads</span><span class="sr-only">でシェア（新しいタブ）</span></a></li>
    <li><button type="button" class="share-btn share-btn--copy" data-share-method="copy_link" data-share-copy data-url="{{ shareUrl }}" hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><g fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1.5 1.5"/><path d="M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1.5-1.5"/></g></svg>
      <span class="share-btn__label">リンクをコピー</span></button></li>
    <li><button type="button" class="share-btn share-btn--native" data-share-method="native_share" data-share-native data-url="{{ shareUrl }}" data-title="{{ title }}" hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><g fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"/></g></svg>
      <span class="share-btn__label">その他</span><span class="sr-only">のアプリで共有</span></button></li>
  </ul>
</div>
